{
  "name": "@hengxin666/hx-memory",
  "version": "0.1.0",
  "description": "HX-Memory: self-maintained pluggable agent memory layer (Port-Adapter kernel: DSH/Codex adapters + pluggable storage + generalization engine)",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "packageManager": "pnpm@10.10.0",
  "files": [
    "dist",
    "dsh/cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dsh": {
      "types": "./dist/adapters/dsh/index.d.ts",
      "import": "./dist/adapters/dsh/index.js"
    },
    "./client": {
      "default": "./dist/dsh/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:s1": "vitest run tests/s1",
    "test:s2": "vitest run tests/s2",
    "lint": "oxlint --config .oxlintrc.json src tests scripts",
    "verify": "bash scripts/verify.sh",
    "verify-structure": "node --experimental-strip-types scripts/verify-structure.ts",
    "verify-field-coverage": "node --experimental-strip-types scripts/verify-field-coverage.ts",
    "verify-gate-evidence": "node --experimental-strip-types scripts/verify-gate-evidence.ts",
    "verify-rpc-coverage": "node --experimental-strip-types scripts/verify-rpc-coverage.ts",
    "verify-real-library": "node --experimental-strip-types scripts/verify-real-library.ts",
    "verify-client-contract": "node --experimental-strip-types scripts/verify-client-contract.ts",
    "mutation-probe": "node --experimental-strip-types scripts/mutation-probe.ts",
    "verify-checks-can-fail": "node --experimental-strip-types scripts/verify-checks-can-fail.ts",
    "verify-docs": "node --experimental-strip-types scripts/verify-docs.ts",
    "verify-agent-note-classification": "uv run scripts/redlines/agent_notes.py --all",
    "verify-agent-note-format": "uv run scripts/redlines/agent_notes.py --all",
    "verify-agent-note-coverage": "uv run scripts/redlines/agent_notes.py --diff",
    "notes:new": "uv run .agents/skills/hx-agent-notes/scripts/setup/new_note.py",
    "graph:preview": "node --experimental-strip-types scripts/graph-preview.ts",
    "verify-bench-snapshot": "node --experimental-strip-types bench/snapshot.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,md,yml,yaml}\"",
    "build:client": "node scripts/build-client.mjs",
    "cli:rules": "node dist/adapters/codex/cli.js rules",
    "verify-notes": "uv run scripts/redlines/agent_notes.py --diff",
    "verify-notes:all": "uv run scripts/redlines/agent_notes.py --all",
    "verify-notes:staged": "uv run scripts/redlines/agent_notes.py --staged"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-connection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.0",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "react": "^18.2.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-connection": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "host": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    }
  },
  "bin": {
    "hx-memory": "./dist/adapters/codex/cli.js"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  }
}
